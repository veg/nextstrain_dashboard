<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pathogen Intelligence Briefing: {{ pathogen_name }}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #e2e8f0; }
    .wrapper { max-width: 680px; margin: 0 auto; background-color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; margin-top: 24px; margin-bottom: 24px; }
    .header { padding: 32px 32px 24px; background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%); border-bottom: 1px solid #334155; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; background-color: #ef4444; color: #ffffff; }
    .title { font-size: 24px; font-weight: 700; color: #ffffff; margin: 12px 0 4px; }
    .subtitle { font-size: 14px; color: #94a3b8; }
    
    .ribbon { display: table; width: 100%; table-layout: fixed; background-color: #0f172a; border-bottom: 1px solid #334155; }
    .metric-cell { display: table-cell; padding: 18px 16px; text-align: center; border-right: 1px solid #334155; }
    .metric-cell:last-child { border-right: none; }
    .metric-value { font-size: 20px; font-weight: 700; color: #38bdf8; }
    .metric-label { font-size: 11px; text-transform: uppercase; color: #94a3b8; margin-top: 4px; letter-spacing: 0.05em; }

    .content { padding: 32px; font-size: 15px; line-height: 1.6; color: #cbd5e1; }
    .exec-card { background-color: #020617; border-left: 4px solid #38bdf8; padding: 16px; border-radius: 0 8px 8px 0; margin-bottom: 24px; font-style: italic; color: #e2e8f0; }
    
    .btn-container { text-align: center; margin: 32px 0 16px; }
    .btn-primary { display: inline-block; background: linear-gradient(135deg, #2563eb, #3b82f6); color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 15px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); }
    
    .footer { padding: 24px 32px; background-color: #0f172a; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #334155; }
    .footer a { color: #38bdf8; text-decoration: none; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <span class="badge">{{ alert_level }}</span>
      <h1 class="title">{{ pathogen_name }} Surveillance Briefing</h1>
      <div class="subtitle">Surveillance Date: {{ date }} &bull; NextGen Surveillance Platform</div>
    </div>

    <div class="ribbon">
      <div class="metric-cell">
        <div class="metric-value">{{ active_sweeps_count }}</div>
        <div class="metric-label">Active Sweeps</div>
      </div>
      <div class="metric-cell">
        <div class="metric-value">{{ max_velocity }}</div>
        <div class="metric-label">Max Velocity</div>
      </div>
      <div class="metric-cell">
        <div class="metric-value">{{ tmrca_horizon }}</div>
        <div class="metric-label">Clock Horizon</div>
      </div>
    </div>

    <div class="content">
      <div class="exec-card">
        {{ executive_summary }}
      </div>

      <div>
        {{ rendered_markdown | safe }}
      </div>

      <div class="btn-container">
        <a href="{{ dashboard_url }}" class="btn-primary" target="_blank">
          Open Synchronized 3D Cockpit &rarr;
        </a>
      </div>
    </div>

    <div class="footer">
      Generated automatically by the Antigravity Intelligence System &bull;
      <a href="{{ repo_url }}">View Source on GitHub</a>
    </div>
  </div>
</body>
</html>
